@model Project2EmailNight.Dtos.ForgotPasswordDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Şifremi Unuttum</title>
    <link rel="icon" href="~/vertical/assets/images/favicon-32x32.png" type="image/png" />
    <link href="~/vertical/assets/css/pace.min.css" rel="stylesheet" />
    <script src="~/vertical/assets/js/pace.min.js"></script>
    <link rel="stylesheet" href="~/vertical/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&family=Roboto&display=swap" />
    <link rel="stylesheet" href="~/vertical/assets/css/icons.css" />
    <link rel="stylesheet" href="~/vertical/assets/css/app.css" />
</head>
<body class="bg-forgot">
    <div class="wrapper">
        <div class="authentication-forgot d-flex align-items-center justify-content-center">
            <div class="card shadow-lg forgot-box">
                <div class="card-body p-md-5">
                    <div class="text-center">
                        <img src="~/vertical/assets/images/icons/forgot-2.png" width="140" alt="">
                    </div>

                    <h4 class="mt-5 font-weight-bold">Şifremi Unuttum</h4>
                    <p class="text-muted">Kayıtlı email adresinizi girin, size sıfırlama linki gönderelim.</p>

                    <!-- Başarı mesajı -->
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success mt-3">
                            <i class="bx bx-check-circle me-1"></i>@ViewBag.Message
                        </div>
                    }

                    <!-- Hata mesajları -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-3">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">E-Posta Adresi</label>
                            <input type="email" class="form-control form-control-lg radius-30"
                                   asp-for="Email" placeholder="ornek@kullanici.com" />
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg radius-30">
                                <i class="bx bx-send me-1"></i>Link Gönder
                            </button>
                            <a href="@Url.Action("UserLogin", "Login")" class="btn btn-light radius-30">
                                <i class="bx bx-arrow-back me-1"></i>Giriş Sayfasına Dön
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
    <script src="~/vertical/assets/js/jquery.min.js"></script>
    <script src="~/vertical/assets/js/bootstrap.bundle.min.js"></script>
</body>
</html>