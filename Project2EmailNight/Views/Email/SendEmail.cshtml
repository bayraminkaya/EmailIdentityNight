@model Project2EmailNight.Dtos.MailRequestDto
@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br /><br />
    <form method="post">
        <label>Alıcı Email</label>
        <input type="text" class="form-control" asp-for="ReceiverEmail" />
        <br />
        <label>Konu</label>
        <input type="text" class="form-control" asp-for="Subject" />
        <br />
        <label>Mesaj</label>
        <input type="text" class="form-control" asp-for="MessageDetail" />
        <br />
        <button class="btn btn-info">Mail Gönder</button>
    </form>
</div>
