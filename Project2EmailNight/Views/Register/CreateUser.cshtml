@model Project2EmailNight.Dtos.UserRegisterDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Kayıt Ol</title>
    <link rel="icon" href="~/vertical/assets/images/favicon-32x32.png" type="image/png" />
    <link href="~/vertical/assets/css/pace.min.css" rel="stylesheet" />
    <script src="~/vertical/assets/js/pace.min.js"></script>
    <link rel="stylesheet" href="~/vertical/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&family=Roboto&display=swap" />
    <link rel="stylesheet" href="~/vertical/assets/css/icons.css" />
    <link rel="stylesheet" href="~/vertical/assets/css/app.css" />
</head>
<body class="bg-register">
    <div class="wrapper">
        <div class="section-authentication-register d-flex align-items-center justify-content-center">
            <div class="row">
                <div class="col-12 col-lg-10 mx-auto">
                    <div class="card radius-15 overflow-hidden">
                        <div class="row g-0">

                            <!-- SOL: FORM -->
                            <div class="col-xl-6">
                                <div class="card-body p-md-5">
                                    <div class="text-center">
                                        <img src="~/vertical/assets/images/logo-icon.png" width="80" alt="">
                                        <h3 class="mt-4 font-weight-bold">Hesap Oluştur</h3>
                                    </div>

                                    <!-- Hata mesajları -->
                                    @if (!ViewData.ModelState.IsValid)
                                    {
                                        <div class="alert alert-danger mt-3">
                                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                            {
                                                <div>@error.ErrorMessage</div>
                                            }
                                        </div>
                                    }

                                    <div class="form-body mt-3">
                                        <form class="row g-3" method="post">
                                            @Html.AntiForgeryToken()

                                            <div class="col-sm-6">
                                                <label class="form-label">Ad</label>
                                                <input type="text" class="form-control" asp-for="Name" placeholder="Adınız">
                                            </div>
                                            <div class="col-sm-6">
                                                <label class="form-label">Soyad</label>
                                                <input type="text" class="form-control" asp-for="Surname" placeholder="Soyadınız">
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Kullanıcı Adı</label>
                                                <input type="text" class="form-control" asp-for="Username" placeholder="kullaniciadi">
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">E-Posta Adresi</label>
                                                <input type="email" class="form-control" asp-for="Email" placeholder="ornek@kullanici.com">
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Şifre</label>
                                                <div class="input-group" id="show_hide_password">
                                                    <input type="password" class="form-control border-end-0" asp-for="Password" placeholder="Şifrenizi giriniz">
                                                    <a href="javascript:;" class="input-group-text bg-transparent">
                                                        <i class="bx bx-hide"></i>
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Ülke</label>
                                                <select class="form-select">
                                                    <option selected="">Türkiye</option>
                                                    <option value="1">Almanya</option>
                                                    <option value="2">Amerika</option>
                                                    <option value="3">İngiltere</option>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="termsCheckbox" required>
                                                    <label class="form-check-label" for="termsCheckbox">
                                                        <a href="javascript:;" data-bs-toggle="modal" data-bs-target="#termsModal">
                                                            Kullanım Koşulları ve Gizlilik Politikası
                                                        </a>'nı okudum ve kabul ediyorum
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bx bx-user me-1"></i>Kayıt Ol
                                                    </button>
                                                </div>
                                            </div>

                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- SAĞ: GÖRSEL -->
                            <div class="col-xl-6 bg-login-color d-flex align-items-center justify-content-center">
                                <img src="~/vertical/assets/images/login-images/register-frent-img.jpg" class="img-fluid" alt="">
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Kullanım Koşulları Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="termsModalLabel">
                        <i class="bx bx-file me-2"></i>Kullanım Koşulları ve Gizlilik Politikası
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-4">

                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                        <i class="bx bx-info-circle fs-5 me-2"></i>
                        <span>Hesabınızı oluşturmadan önce lütfen bu koşulları dikkatlice okuyunuz.</span>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2">
                            <i class="bx bx-check-shield me-1"></i> 1. Koşulların Kabulü
                        </h6>
                        <p class="text-muted">
                            Bu platformu kullanarak aşağıdaki Kullanım Koşullarını kabul etmiş sayılırsınız.
                            Bu koşulları kabul etmiyorsanız lütfen hizmeti kullanmayınız.
                            Koşulları önceden bildirim yaparak güncelleme hakkımızı saklı tutarız.
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2">
                            <i class="bx bx-user-check me-1"></i> 2. Kullanıcı Sorumlulukları
                        </h6>
                        <ul class="text-muted ps-3">
                            <li class="mb-1">Kayıt sırasında doğru ve eksiksiz bilgi sağlamakla yükümlüsünüz.</li>
                            <li class="mb-1">Hesap bilgilerinizin gizliliğini korumak sizin sorumluluğunuzdadır.</li>
                            <li class="mb-1">Hesabınızı başkalarıyla paylaşamaz veya başkasının hesabını kullanamazsınız.</li>
                            <li class="mb-1">Yürürlükteki yasa ve yönetmelikleri ihlal eden her türlü faaliyet kesinlikle yasaktır.</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2">
                            <i class="bx bx-lock-alt me-1"></i> 3. Gizlilik Politikası
                        </h6>
                        <p class="text-muted">
                            Kişisel verileriniz, 6698 sayılı Kişisel Verilerin Korunması Kanunu (KVKK) kapsamında korunmaktadır.
                            Yalnızca hizmetlerimizi sunmak için gerekli bilgileri topluyoruz.
                        </p>
                        <ul class="text-muted ps-3">
                            <li class="mb-1">E-posta adresiniz yalnızca hesap yönetimi ve bildirimler için kullanılır.</li>
                            <li class="mb-1">Kişisel verileriniz, rızanız olmaksızın üçüncü taraflarla paylaşılmaz veya satılmaz.</li>
                            <li class="mb-1">Hesabınızın ve verilerinizin silinmesini istediğiniz zaman talep edebilirsiniz.</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2">
                            <i class="bx bx-envelope me-1"></i> 4. E-Posta İletişimi
                        </h6>
                        <p class="text-muted">
                            Kayıt olarak, hesap etkinliğinizle ilgili işlemsel e-postalar almayı kabul etmiş olursunuz.
                            Tanıtım amaçlı e-postalardan istediğiniz zaman hesap ayarlarınızdan çıkabilirsiniz.
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2">
                            <i class="bx bx-block me-1"></i> 5. Hesap Askıya Alma
                        </h6>
                        <p class="text-muted">
                            Bu koşulları ihlal eden, sahte faaliyetlerde bulunan veya platformu kötüye kullanan
                            hesapları askıya alma veya sonlandırma hakkımızı saklı tutarız.
                        </p>
                    </div>

                    <div class="mb-2">
                        <h6 class="fw-bold text-primary border-bottom pb-2">
                            <i class="bx bx-revision me-1"></i> 6. Koşullardaki Değişiklikler
                        </h6>
                        <p class="text-muted mb-0">
                            Bu koşulları periyodik olarak güncelleyebiliriz. Değişikliklerden sonra platformu kullanmaya
                            devam etmeniz güncellenmiş koşulları kabul ettiğiniz anlamına gelir. Son güncelleme: Nisan 2026.
                        </p>
                    </div>

                </div>
                <div class="modal-footer justify-content-between">
                    <small class="text-muted">
                        <i class="bx bx-info-circle me-1"></i>
                        "Kabul Ediyorum" butonuna tıklayarak yukarıdaki tüm koşulları kabul etmiş olursunuz.
                    </small>
                    <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">
                        <i class="bx bx-check me-1"></i> Kabul Ediyorum
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/vertical/assets/js/jquery.min.js"></script>
    <script src="~/vertical/assets/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#show_hide_password a").on('click', function (event) {
                event.preventDefault();
                if ($('#show_hide_password input').attr("type") == "text") {
                    $('#show_hide_password input').attr('type', 'password');
                    $('#show_hide_password i').addClass("bx-hide").removeClass("bx-show");
                } else {
                    $('#show_hide_password input').attr('type', 'text');
                    $('#show_hide_password i').removeClass("bx-hide").addClass("bx-show");
                }
            });
        });
    </script>
</body>
</html>