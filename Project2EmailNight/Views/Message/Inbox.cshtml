@model List<Project2EmailNight.Entities.Message>
@{
    Layout = null;
    var user = ViewBag.CurrentUser as Project2EmailNight.Entities.AppUser;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Gelen Kutusu</title>
    <link rel="icon" href="~/vertical/assets/images/favicon-32x32.png" type="image/png" />
    <link href="~/vertical/assets/plugins/simplebar/css/simplebar.css" rel="stylesheet" />
    <link href="~/vertical/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/vertical/assets/plugins/metismenu/css/metisMenu.min.css" rel="stylesheet" />
    <link href="~/vertical/assets/css/pace.min.css" rel="stylesheet" />
    <script src="~/vertical/assets/js/pace.min.js"></script>
    <link rel="stylesheet" href="~/vertical/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&family=Roboto&display=swap" />
    <link rel="stylesheet" href="~/vertical/assets/css/icons.css" />
    <link rel="stylesheet" href="~/vertical/assets/css/app.css" />
</head>
<body>
    <div class="wrapper">

        <!-- HEADER -->
        <header class="top-header">
            <nav class="navbar navbar-expand">
                <!-- Logo -->
                <div class="left-topbar d-flex align-items-center ms-3">
                    <img src="~/vertical/assets/images/logo-icon.png" width="36" alt="logo">
                    <span class="ms-2 fw-bold fs-5">Syndash</span>
                </div>

                <div class="right-topbar ms-auto">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown dropdown-user-profile">
                            <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="javascript:;" data-bs-toggle="dropdown">
                                <div class="d-flex user-box align-items-center">
                                    <div class="user-info">
                                        <p class="user-name mb-0">@user?.Name @user?.Surname</p>
                                        <p class="designattion mb-0">Çevrimiçi</p>
                                    </div>
                                    <img src="~/vertical/assets/images/avatars/avatar-1.png" class="user-img" alt="kullanıcı">
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item" href="@Url.Action("Index", "Profile")">
                                    <i class="bx bx-user"></i><span>Profil</span>
                                </a>
                                <div class="dropdown-divider mb-0"></div>
                                <a class="dropdown-item" href="@Url.Action("Logout", "Login")">
                                    <i class="bx bx-power-off"></i><span>Çıkış Yap</span>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <!-- PAGE WRAPPER -->
        <div class="page-wrapper">
            <div class="page-content-wrapper">
                <div class="page-content">
                    <div class="email-wrapper">

                        <!-- SOL PANEL (sol menü yok, sadece email sidebar) -->
                        <div class="email-sidebar">
                            <div class="email-sidebar-header d-grid">
                                <button class="btn btn-primary compose-mail-btn" onclick="openCompose()">
                                    <i class='bx bx-plus me-2'></i>Yeni Mesaj
                                </button>
                            </div>
                            <div class="email-sidebar-content">
                                <div class="email-navigation">
                                    <div class="list-group list-group-flush">
                                        <a href="@Url.Action("Inbox", "Message")"
                                           class="list-group-item active d-flex align-items-center">
                                            <i class='bx bxs-inbox me-3 font-20'></i>
                                            <span>Gelen Kutusu</span>
                                            <span class="badge bg-primary rounded-pill ms-auto">@Model.Count</span>
                                        </a>
                                        <a href="javascript:;" class="list-group-item d-flex align-items-center">
                                            <i class='bx bxs-star me-3 font-20'></i>
                                            <span>Yıldızlılar</span>
                                        </a>
                                        <a href="@Url.Action("Sendbox", "Message")"
                                           class="list-group-item d-flex align-items-center">
                                            <i class='bx bxs-send me-3 font-20'></i>
                                            <span>Gönderilenler</span>
                                        </a>
                                        <a href="javascript:;" class="list-group-item d-flex align-items-center">
                                            <i class='bx bxs-file-blank me-3 font-20'></i>
                                            <span>Taslaklar</span>
                                        </a>
                                        <div class="list-group-item text-muted" style="font-size:12px;">KATEGORİLER</div>
                                        <a href="javascript:;" class="list-group-item d-flex align-items-center">
                                            <i class='bx bx-briefcase me-3 font-20 text-primary'></i>
                                            <span>İş E-postaları</span>
                                        </a>
                                        <a href="javascript:;" class="list-group-item d-flex align-items-center">
                                            <i class='bx bx-book me-3 font-20 text-success'></i>
                                            <span>Eğitim E-postaları</span>
                                        </a>
                                        <a href="javascript:;" class="list-group-item d-flex align-items-center">
                                            <i class='bx bx-home-heart me-3 font-20 text-danger'></i>
                                            <span>Aile E-postaları</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- EMAIL HEADER -->
                        <div class="email-header d-xl-flex align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="email-toggle-btn"><i class='bx bx-menu'></i></div>
                            </div>
                            <div class="flex-grow-1 mx-xl-2 my-2 my-xl-0">
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent"><i class="bx bx-search"></i></span>
                                    <input type="text" class="form-control" placeholder="Mesajlarda ara..." id="searchInput" />
                                </div>
                            </div>
                            <div class="ms-auto d-flex align-items-center">
                                <span class="btn btn-sm btn-light">Toplam: @Model.Count mesaj</span>
                            </div>
                        </div>

                        <!-- EMAIL LİSTESİ -->
                        <div class="email-content">
                            <div class="email-list" id="emailList">
                                @if (!Model.Any())
                                {
                                    <div class="text-center p-5 text-muted">
                                        <i class='bx bx-inbox' style="font-size:48px;"></i>
                                        <p class="mt-3">Gelen kutunuz boş.</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <a href="/Message/MessageDetail/@item.MessageId">
                                            <div class="d-md-flex align-items-center email-message px-3 py-1 @(item.IsStatus ? "" : "fw-bold")">
                                                <div class="d-flex align-items-center email-actions">
                                                    <i class='bx bx-star font-20 mx-2 email-star'></i>
                                                    <p class="mb-0">@item.SenderEMail</p>
                                                </div>
                                                <div class="ms-3 flex-grow-1">
                                                    <p class="mb-0">
                                                        <span class="me-2">@item.Subject</span>
                                                        <span class="text-muted fw-normal">— @item.MessageDetail</span>
                                                    </p>
                                                </div>
                                                <div class="ms-auto d-flex align-items-center gap-2">
                                                    <p class="mb-0 email-time">@item.SendDate.ToString("dd MMM")</p>
                                                    <a href="/Message/MessageDelete/@item.MessageId"
                                                       class="btn btn-sm btn-light"
                                                       onclick="event.preventDefault(); event.stopPropagation(); if(confirm('Mesajı silmek istiyor musunuz?')) window.location='/Message/MessageDelete/@item.MessageId';">
                                                        <i class='bx bx-trash'></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </a>
                                    }
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- COMPOSE POPUP -->
    <div class="compose-mail-popup" id="composePopup" style="display:none;">
        <div class="card">
            <div class="card-header bg-dark text-white py-2 cursor-pointer" onclick="toggleCompose()">
                <div class="d-flex align-items-center">
                    <div class="compose-mail-title">
                        <i class='bx bx-edit me-2'></i>Yeni Mesaj
                    </div>
                    <div class="ms-auto" onclick="event.stopPropagation(); closeCompose()" style="cursor:pointer; font-size:18px;">×</div>
                </div>
            </div>
            <div class="card-body" id="composeBody">
                <form method="post" action="@Url.Action("CreateMessage","Message")" id="composeForm">
                    @Html.AntiForgeryToken()
                    <div class="email-form">
                        <div class="mb-3">
                            <input type="text" class="form-control" name="ReceiverEmail" placeholder="Alıcı" required />
                        </div>
                        <div class="mb-3">
                            <input type="text" class="form-control" name="Subject" placeholder="Konu" required />
                        </div>
                        <div class="mb-3">
                            <textarea class="form-control" name="MessageDetail"
                                      placeholder="Mesajınızı yazın..."
                                      rows="8" required></textarea>
                        </div>
                        <div class="mb-0">
                            <div class="d-flex align-items-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class='bx bx-send me-1'></i>Gönder
                                </button>
                                <div class="ms-auto">
                                    <button type="button" class="btn border-0 btn-sm btn-white" onclick="closeCompose()">
                                        <i class="lni lni-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/vertical/assets/js/jquery.min.js"></script>
    <script src="~/vertical/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/vertical/assets/plugins/simplebar/js/simplebar.min.js"></script>
    <script src="~/vertical/assets/plugins/metismenu/js/metisMenu.min.js"></script>
    <script src="~/vertical/assets/plugins/perfect-scrollbar/js/perfect-scrollbar.js"></script>
    <script src="~/vertical/assets/js/app.js"></script>
    <script>
        new PerfectScrollbar('.email-navigation');
        new PerfectScrollbar('.email-list');

        function openCompose() {
            $('#composePopup').show();
        }

        function closeCompose() {
            $('#composePopup').hide();
        }

        function toggleCompose() {
            $('#composeBody').toggle();
        }

        document.getElementById('searchInput').addEventListener('input', function () {
            var query = this.value.toLowerCase();
            document.querySelectorAll('#emailList a').forEach(function (item) {
                item.style.display = item.innerText.toLowerCase().includes(query) ? '' : 'none';
            });
        });
    </script>
</body>
</html>