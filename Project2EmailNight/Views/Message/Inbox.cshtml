@using System.Linq
@using System.Text.RegularExpressions
@using System.Net
@model List<Project2EmailNight.Entities.Message>
@{
    Layout = null;
    var user = ViewBag.CurrentUser as Project2EmailNight.Entities.AppUser;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count;
    int pageSize = 13;
    int startItem = totalItems > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    int endItem = totalItems > 0 ? startItem + Model.Count - 1 : 0;

    string activeFolder = ViewBag.ActiveFolder ?? "Inbox";
    string baseUrl = "";
    string searchQuery = Context.Request.Query["query"].ToString() ?? "";

    if (activeFolder == "Search")
    {
        baseUrl = "/Message/Search?query=" + searchQuery + "&page=";
    }
    else if (activeFolder == "İş" || activeFolder == "Aile" || activeFolder == "Eğitim" || activeFolder == "Sosyal")
    {
        baseUrl = "/Message/Category/" + activeFolder + "?page=";
    }
    else
    {
        baseUrl = "/Message/" + activeFolder + "?page=";
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Gelen Kutusu — Syndash Mail</title>
    <link rel="icon" href="~/vertical/assets/images/favicon-32x32.png" type="image/png" />
    <link href="~/vertical/assets/plugins/simplebar/css/simplebar.css" rel="stylesheet" />
    <link href="~/vertical/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/vertical/assets/plugins/metismenu/css/metisMenu.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/vertical/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/vertical/assets/css/icons.css" />
    <link rel="stylesheet" href="~/vertical/assets/css/app.css" />
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #7c3aed;
            --primary-light: #ede9fe;
            --primary-dark: #6d28d9;
            --primary-hover: #8b5cf6;
            --surface: #ffffff;
            --surface-hover: #faf8ff;
            --surface-alt: #f8fafc;
            --border: #e2e8f0;
            --border-light: #f1f5f9;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
            --shadow-lg: 0 12px 40px rgba(0,0,0,0.12);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
        }

        /* ===== RESET ===== */
        .sidebar-wrapper {
            display: none !important;
        }

        body {
            background: #f8fafc !important;
        }

        .page-wrapper {
            margin-left: 0 !important;
            margin-top: 64px !important;
            padding: 0 !important;
        }

        .page-content-wrapper, .page-content {
            padding: 0 !important;
            margin: 0 !important;
        }

        /* ===== HEADER ===== */
        .top-header {
            left: 0 !important;
            width: 100% !important;
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            height: 64px;
            z-index: 100;
        }

            .top-header .navbar {
                height: 64px;
            }

        .logo-text {
            font-weight: 700 !important;
            font-size: 20px !important;
            background: linear-gradient(135deg, var(--primary), #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.3px;
        }

        .header-search {
            max-width: 480px;
            position: relative;
        }

            .header-search input {
                border: 2px solid var(--border) !important;
                border-radius: 50px !important;
                padding: 8px 20px 8px 44px !important;
                font-size: 13.5px;
                background: var(--surface-alt) !important;
                transition: all 0.25s;
                height: 40px;
            }

                .header-search input:focus {
                    border-color: var(--primary-hover) !important;
                    background: var(--surface) !important;
                    box-shadow: 0 0 0 3px rgba(124,58,237,0.1) !important;
                }

            .header-search .search-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 16px;
                z-index: 5;
            }

        .header-badge {
            width: 18px;
            height: 18px;
            font-size: 10px !important;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary) !important;
            border: 2px solid var(--surface);
            top: 2px !important;
            right: 2px !important;
        }

        .user-box .user-name {
            font-weight: 600;
            font-size: 13.5px;
            color: var(--text-primary);
        }

        .user-box .designattion {
            font-size: 11px;
            color: var(--text-muted);
        }

        .user-box .user-img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid var(--border);
        }

        /* ===== EMAIL WRAPPER ===== */
        .email-wrapper {
            height: calc(100vh - 64px) !important;
            min-height: calc(100vh - 64px) !important;
        }

        /* ===== SIDEBAR ===== */
        .email-sidebar {
            border-right: 1px solid var(--border) !important;
            background: var(--surface) !important;
            height: 100% !important;
            overflow-y: auto !important;
            width: 260px !important;
            min-width: 260px !important;
        }

        .email-sidebar-header {
            padding: 20px 20px 12px !important;
        }

        .compose-btn {
            background: linear-gradient(135deg, var(--primary), #9333ea) !important;
            border: none !important;
            border-radius: 50px !important;
            padding: 11px 24px !important;
            font-weight: 600 !important;
            font-size: 14px !important;
            letter-spacing: 0.2px;
            box-shadow: 0 4px 14px rgba(124,58,237,0.35);
            transition: all 0.25s;
            color: #fff !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .compose-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(124,58,237,0.45);
                background: linear-gradient(135deg, var(--primary-hover), #a855f7) !important;
            }

        .email-navigation {
            height: auto !important;
            padding: 4px 12px;
        }

            .email-navigation .list-group-item {
                border: none !important;
                padding: 9px 14px !important;
                font-size: 13.5px;
                font-weight: 500;
                color: var(--text-secondary);
                border-radius: var(--radius-sm) !important;
                margin-bottom: 2px;
                transition: all 0.2s;
                border-left: 3px solid transparent !important;
            }

                .email-navigation .list-group-item:hover {
                    background: var(--surface-hover) !important;
                    color: var(--primary);
                }

                .email-navigation .list-group-item.active {
                    background: var(--primary-light) !important;
                    color: var(--primary) !important;
                    font-weight: 600;
                    border-left: 3px solid var(--primary) !important;
                    border-radius: 0 var(--radius-sm) var(--radius-sm) 0 !important;
                }

                .email-navigation .list-group-item .badge {
                    font-size: 11px;
                    font-weight: 600;
                    padding: 3px 8px;
                }

        .sidebar-label {
            font-size: 10px !important;
            font-weight: 700 !important;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-muted) !important;
            padding: 16px 14px 6px !important;
        }

        /* ===== TOOLBAR ===== */
        .email-header {
            border-bottom: 1px solid var(--border) !important;
            background: var(--surface) !important;
            height: 52px !important;
            padding: 0 16px !important;
        }

        .toolbar-btn {
            width: 34px;
            height: 34px;
            border-radius: var(--radius-sm) !important;
            border: 1px solid var(--border) !important;
            background: var(--surface) !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            transition: all 0.2s;
            padding: 0 !important;
            font-size: 16px;
        }

            .toolbar-btn:hover {
                background: var(--surface-hover) !important;
                border-color: var(--primary-hover) !important;
                color: var(--primary);
            }

        .toolbar-search input {
            border: 1.5px solid var(--border) !important;
            border-radius: var(--radius-sm) !important;
            font-size: 13px;
            padding: 6px 12px 6px 36px;
            height: 34px;
            transition: all 0.2s;
        }

            .toolbar-search input:focus {
                border-color: var(--primary-hover) !important;
                box-shadow: 0 0 0 3px rgba(124,58,237,0.08) !important;
            }

        .pagination-info {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            padding: 5px 10px;
            background: var(--surface-alt);
            border-radius: 6px;
        }

        .page-btn {
            width: 30px;
            height: 30px;
            border-radius: 6px !important;
            border: 1px solid var(--border) !important;
            background: var(--surface) !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
            color: var(--text-secondary);
            transition: all 0.15s;
            text-decoration: none;
        }

            .page-btn:hover:not([disabled]) {
                background: var(--primary-light) !important;
                border-color: var(--primary-hover) !important;
                color: var(--primary) !important;
            }

        /* ===== EMAIL CONTENT ===== */
        .email-content {
            background: var(--surface) !important;
        }

        /* ===== EMAIL ROW ===== */
        .email-row {
            display: flex;
            align-items: center;
            padding: 0 20px;
            min-height: 52px;
            border-bottom: 1px solid var(--border-light);
            cursor: pointer;
            transition: all 0.15s;
            position: relative;
        }

            .email-row::after {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 3px;
                background: var(--primary);
                opacity: 0;
                transition: opacity 0.2s;
                border-radius: 0 2px 2px 0;
            }

            .email-row:hover {
                background: var(--surface-hover);
            }

                .email-row:hover::after {
                    opacity: 1;
                }

            .email-row.unread {
                background: var(--surface);
            }

            .email-row.read {
                background: var(--surface-alt);
            }

                .email-row.read:hover {
                    background: var(--surface-hover);
                }

        .mail-avatar {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: #fff;
            flex-shrink: 0;
        }

        .mail-sender {
            width: 180px;
            min-width: 180px;
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex-shrink: 0;
            font-size: 13px;
        }

        .mail-subject {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            min-width: 0;
            font-size: 13px;
        }

        .mail-star {
            font-size: 17px;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }

            .mail-star.text-muted:hover {
                color: #facc15 !important;
                transform: scale(1.15);
            }

        .cat-badge {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 9px;
            border-radius: 50px;
            letter-spacing: 0.3px;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .mail-delete {
            opacity: 0;
            transition: all 0.15s;
            color: var(--text-muted);
            font-size: 18px;
        }

            .mail-delete:hover {
                color: #ef4444 !important;
                transform: scale(1.1);
            }

        .email-row:hover .mail-delete {
            opacity: 1;
        }

        .mail-date {
            font-size: 11.5px;
            font-weight: 500;
            color: var(--text-muted);
            white-space: nowrap;
            min-width: 85px;
            text-align: right;
        }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 100px 20px;
        }

        .empty-state-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

            .empty-state-icon i {
                font-size: 36px;
                color: var(--primary);
            }

        .empty-state h5 {
            color: var(--text-primary);
            font-weight: 600;
            margin-bottom: 6px;
        }

        .empty-state p {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* ===== COMPOSE ===== */
        .compose-popup {
            position: fixed;
            bottom: 0;
            right: 28px;
            width: 520px;
            z-index: 9999;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
            overflow: hidden;
            box-shadow: var(--shadow-lg), 0 0 0 1px rgba(0,0,0,0.04);
            display: none;
            animation: slideUp 0.3s ease;
        }

        @@keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .compose-header {
            background: linear-gradient(135deg, var(--primary), #9333ea);
            color: #fff;
            padding: 12px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .compose-header-title {
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .compose-header-actions span {
            cursor: pointer;
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: background 0.15s;
        }

            .compose-header-actions span:hover {
                background: rgba(255,255,255,0.2);
            }

        .compose-body {
            background: var(--surface);
        }

        .compose-field {
            border: none;
            border-bottom: 1px solid var(--border-light);
            padding: 12px 20px;
            font-size: 14px;
            width: 100%;
            outline: none;
            background: transparent;
            color: var(--text-primary);
            transition: border-color 0.2s;
        }

            .compose-field:focus {
                border-bottom-color: var(--primary-hover);
            }

            .compose-field::placeholder {
                color: var(--text-muted);
            }

        .compose-select {
            border: none;
            border-bottom: 1px solid var(--border-light);
            padding: 12px 20px;
            font-size: 14px;
            width: 100%;
            outline: none;
            background: transparent;
            color: var(--text-muted);
            box-shadow: none !important;
            border-radius: 0;
            cursor: pointer;
        }

            .compose-select:focus {
                border-bottom-color: var(--primary-hover);
                color: var(--text-primary);
            }

        .compose-footer {
            padding: 12px 20px;
            border-top: 1px solid var(--border-light);
            background: var(--surface-alt);
            display: flex;
            align-items: center;
        }

        .send-btn {
            background: linear-gradient(135deg, var(--primary), #9333ea) !important;
            border: none !important;
            border-radius: 50px !important;
            padding: 8px 28px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            color: #fff !important;
            box-shadow: 0 2px 8px rgba(124,58,237,0.3);
            transition: all 0.2s;
        }

            .send-btn:hover {
                box-shadow: 0 4px 14px rgba(124,58,237,0.4);
                transform: translateY(-1px);
            }

        .compose-icon-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
            font-size: 16px;
        }

            .compose-icon-btn.danger:hover {
                background: #fef2f2;
                color: #ef4444;
            }

        /* ===== Summernote ===== */
        .note-editor.note-frame {
            border: none !important;
            box-shadow: none !important;
        }

        .note-toolbar {
            background: var(--surface-alt) !important;
            border-bottom: 1px solid var(--border-light) !important;
            padding: 4px 8px !important;
        }

        .note-editing-area {
            background: var(--surface) !important;
        }

        .note-editable {
            padding: 16px 20px !important;
            font-size: 14px !important;
            color: var(--text-primary) !important;
        }

        /* ===== CHECKBOX ===== */
        .form-check-input {
            border-radius: 4px !important;
            border-color: var(--border) !important;
            cursor: pointer;
        }

            .form-check-input:checked {
                background-color: var(--primary) !important;
                border-color: var(--primary) !important;
            }

            .form-check-input:focus {
                box-shadow: 0 0 0 3px rgba(124,58,237,0.15) !important;
            }

        /* ===== SCROLLBAR ===== */
        .email-list::-webkit-scrollbar, .email-sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .email-list::-webkit-scrollbar-track, .email-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .email-list::-webkit-scrollbar-thumb, .email-sidebar::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <div class="wrapper">

        <!-- HEADER -->
        <header class="top-header">
            <nav class="navbar navbar-expand">
                <div class="left-topbar d-flex align-items-center">
                    <img src="~/vertical/assets/images/logo-icon.png" width="32" alt="logo" class="ms-3" />
                    <span class="logo-text ms-2">Syndash</span>
                </div>
                <div class="flex-grow-1 px-4">
                    <div class="header-search position-relative" style="max-width:480px;">
                        <i class="bx bx-search search-icon"></i>
                        <form method="get" action="/Message/Search">
                            <input type="text" name="query" class="form-control"
                                   placeholder="Mail Kutusunda Ara..." value="@searchQuery" />
                        </form>
                    </div>
                </div>
                <div class="right-topbar ms-auto">
                    <ul class="navbar-nav align-items-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link position-relative px-2" href="javascript:;">
                                <i class="bx bx-comment-detail" style="font-size:20px;color:var(--text-secondary);"></i>
                                @if (ViewBag.InboxCount != null && (int)ViewBag.InboxCount > 0)
                                {
                                    <span class="badge rounded-pill position-absolute header-badge">@ViewBag.InboxCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2" href="javascript:;">
                                <i class="bx bx-bell" style="font-size:20px;color:var(--text-secondary);"></i>
                            </a>
                        </li>
                        <li class="nav-item dropdown dropdown-user-profile ms-2">
                            <a class="nav-link dropdown-toggle dropdown-toggle-nocaret p-0"
                               href="javascript:;" data-bs-toggle="dropdown">
                                <div class="d-flex user-box align-items-center">
                                    <div class="user-info text-end me-2">
                                        <p class="user-name mb-0">@user?.Name @user?.Surname</p>
                                        <p class="designattion mb-0">Çevrimiçi</p>
                                    </div>
                                    @if (!string.IsNullOrEmpty(user?.ImageUrl))
                                    {
                                        <img src="~/images/@user.ImageUrl" class="user-img" alt="kullanıcı" />
                                    }
                                    else
                                    {
                                        <img src="~/vertical/assets/images/avatars/avatar-1.png" class="user-img" alt="kullanıcı" />
                                    }
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="border-radius:var(--radius-md);">
                                <a class="dropdown-item py-2" href="/Profile/Index"><i class="bx bx-user me-2"></i>Profilim</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item py-2 text-danger" href="/Login/Logout"><i class="bx bx-power-off me-2"></i>Çıkış Yap</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <!-- PAGE -->
        <div class="page-wrapper">
            <div class="page-content-wrapper">
                <div class="page-content">
                    <div class="email-wrapper">

                        <!-- SIDEBAR -->
                        <div class="email-sidebar">
                            <div class="email-sidebar-header d-grid">
                                <a href="javascript:;" class="compose-btn" onclick="openCompose()">
                                    <i class='bx bx-plus' style="font-size:18px;"></i>
                                    <span>Yeni Mesaj</span>
                                </a>
                            </div>
                            <div class="email-sidebar-content">
                                <div class="email-navigation">
                                    <div class="list-group list-group-flush">
                                        @{
                                            string inboxActive = (activeFolder == "Inbox") ? "active" : "";
                                            string starredActive = (activeFolder == "Starred") ? "active" : "";
                                            string sendboxActive = (activeFolder == "SendBox") ? "active" : "";
                                            string draftsActive = (activeFolder == "Drafts") ? "active" : "";
                                            string spamActive = (activeFolder == "Spam") ? "active" : "";
                                            string trashActive = (activeFolder == "Trash") ? "active" : "";
                                        }
                                        <a href="/Message/Inbox" class="list-group-item @inboxActive d-flex align-items-center">
                                            <i class='bx bxs-inbox me-3' style="font-size:18px;"></i><span>Gelen Kutusu</span>
                                            @if (ViewBag.InboxCount != null && (int)ViewBag.InboxCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:var(--primary);">@ViewBag.InboxCount</span>
                                            }
                                        </a>
                                        <a href="/Message/Starred" class="list-group-item @starredActive d-flex align-items-center">
                                            <i class='bx bxs-star me-3' style="font-size:18px;color:#facc15;"></i><span>Yıldızlılar</span>
                                            @if (ViewBag.StarredCount != null && (int)ViewBag.StarredCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:var(--primary);">@ViewBag.StarredCount</span>
                                            }
                                        </a>
                                        <a href="/Message/Sendbox" class="list-group-item @sendboxActive d-flex align-items-center">
                                            <i class='bx bxs-send me-3' style="font-size:18px;color:#3b82f6;"></i><span>Gönderilenler</span>
                                            @if (ViewBag.SendBoxCount != null && (int)ViewBag.SendBoxCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:var(--primary);">@ViewBag.SendBoxCount</span>
                                            }
                                        </a>
                                        <a href="javascript:;" class="list-group-item @draftsActive d-flex align-items-center">
                                            <i class='bx bxs-file-blank me-3' style="font-size:18px;color:var(--text-muted);"></i><span>Taslaklar</span>
                                        </a>
                                        <a href="javascript:;" class="list-group-item @spamActive d-flex align-items-center">
                                            <i class='bx bxs-error-circle me-3' style="font-size:18px;color:#ef4444;"></i><span>Spam</span>
                                        </a>
                                        <a href="/Message/Trash" class="list-group-item @trashActive d-flex align-items-center">
                                            <i class='bx bxs-trash-alt me-3' style="font-size:18px;color:var(--text-muted);"></i><span>Çöp Kutusu</span>
                                            @if (ViewBag.TrashCount != null && (int)ViewBag.TrashCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:var(--primary);">@ViewBag.TrashCount</span>
                                            }
                                        </a>
                                    </div>
                                    <div class="list-group list-group-flush mt-1">
                                        <div class="sidebar-label list-group-item" style="background:transparent;border:none;">KATEGORİLER</div>
                                        @{
                                            string isActive = (activeFolder == "İş") ? "active" : "";
                                            string aileActive = (activeFolder == "Aile") ? "active" : "";
                                            string egitimActive = (activeFolder == "Eğitim") ? "active" : "";
                                            string sosyalActive = (activeFolder == "Sosyal") ? "active" : "";
                                        }
                                        <a href="/Message/Category/İş" class="list-group-item @isActive d-flex align-items-center">
                                            <span class="me-3" style="width:10px;height:10px;border-radius:50%;background:var(--primary);display:inline-block;flex-shrink:0;"></span><span>İş</span>
                                            @if (ViewBag.IsCount != null && (int)ViewBag.IsCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:var(--primary);">@ViewBag.IsCount</span>
                                            }
                                        </a>
                                        <a href="/Message/Category/Aile" class="list-group-item @aileActive d-flex align-items-center">
                                            <span class="me-3" style="width:10px;height:10px;border-radius:50%;background:#22c55e;display:inline-block;flex-shrink:0;"></span><span>Aile</span>
                                            @if (ViewBag.AileCount != null && (int)ViewBag.AileCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:#22c55e;">@ViewBag.AileCount</span>
                                            }
                                        </a>
                                        <a href="/Message/Category/Eğitim" class="list-group-item @egitimActive d-flex align-items-center">
                                            <span class="me-3" style="width:10px;height:10px;border-radius:50%;background:#ef4444;display:inline-block;flex-shrink:0;"></span><span>Eğitim</span>
                                            @if (ViewBag.EgitimCount != null && (int)ViewBag.EgitimCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto" style="background:#ef4444;">@ViewBag.EgitimCount</span>
                                            }
                                        </a>
                                        <a href="/Message/Category/Sosyal" class="list-group-item @sosyalActive d-flex align-items-center">
                                            <span class="me-3" style="width:10px;height:10px;border-radius:50%;background:#f59e0b;display:inline-block;flex-shrink:0;"></span><span>Sosyal</span>
                                            @if (ViewBag.SosyalCount != null && (int)ViewBag.SosyalCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-auto text-dark" style="background:#f59e0b;">@ViewBag.SosyalCount</span>
                                            }
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TOOLBAR -->
                        <div class="email-header d-xl-flex align-items-center">
                            <div class="d-flex align-items-center gap-1">
                                <div class="email-toggle-btn"><i class='bx bx-menu'></i></div>
                                <div class="toolbar-btn" style="width:auto;padding:0 8px !important;">
                                    <input class="form-check-input m-0" type="checkbox" id="selectAll"
                                           onchange="toggleSelectAll(this)" title="Hepsini Seç" style="width:15px;height:15px;" />
                                </div>
                                <button type="button" class="toolbar-btn" onclick="location.reload()" title="Yenile"><i class='bx bx-refresh'></i></button>
                                <button type="button" class="toolbar-btn d-none d-md-inline-flex" title="Arşivle"><i class='bx bx-archive-in'></i></button>
                                <button type="button" class="toolbar-btn" onclick="deleteSelected()" title="Seçilenleri Sil"><i class='bx bx-trash'></i></button>
                            </div>
                            <div class="flex-grow-1 mx-xl-3 my-2 my-xl-0">
                                <form method="get" action="/Message/Search" class="toolbar-search position-relative" style="max-width:400px;">
                                    <i class="bx bx-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:15px;"></i>
                                    <input type="text" name="query" class="form-control" placeholder="Maillerde Ara..." value="@searchQuery" id="searchInput" />
                                    <button type="submit" class="d-none"></button>
                                </form>
                            </div>
                            <div class="ms-auto d-flex align-items-center gap-1">
                                <span class="pagination-info">@startItem–@endItem / @totalItems</span>
                                @if (currentPage > 1)
                                {
                                    <a href="@(baseUrl + (currentPage - 1))" class="page-btn"><i class='bx bx-chevron-left' style="font-size:18px;"></i></a>
                                }
                                else
                                {

                                    <button class="page-btn" disabled style="opacity:0.4;cursor:default;"><i class='bx bx-chevron-left' style="font-size:18px;"></i></button>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <a href="@(baseUrl + (currentPage + 1))" class="page-btn"><i class='bx bx-chevron-right' style="font-size:18px;"></i></a>
                                }
                                else
                                {

                                    <button class="page-btn" disabled style="opacity:0.4;cursor:default;"><i class='bx bx-chevron-right' style="font-size:18px;"></i></button>
                                }
                            </div>
                        </div>

                        <!-- EMAIL LIST -->
                        <div class="email-content">
                            <div class="email-list" id="emailList">
                                @if (!Model.Any())
                                {
                                    <div class="empty-state">
                                        <div class="empty-state-icon"><i class='bx bx-envelope-open'></i></div>
                                        <h5>Bu klasör şu an boş</h5>
                                        <p>Yeni mesajlar burada görünecek.</p>
                                    </div>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        string[] colors = new[] { "#7c3aed", "#3b82f6", "#22c55e", "#ef4444", "#f59e0b", "#14b8a6", "#8b5cf6", "#ec4899" };
                                        string senderEmail = (activeFolder == "SendBox") ? (item.ReceiverEmail ?? "") : (item.SenderEMail ?? "");
                                        int colorIndex = Math.Abs(senderEmail.GetHashCode()) % colors.Length;
                                        string avatarColor = colors[colorIndex];
                                        string avatarLetter = senderEmail.Length > 0 ? senderEmail[0].ToString().ToUpper() : "?";
                                        bool isRead = item.IsStatus;
                                        bool isStarred = item.IsStarred;

                                        string rawDetail = item.MessageDetail ?? "";
                                        string cleanText = Regex.Replace(rawDetail, "<.*?>", string.Empty);
                                        cleanText = WebUtility.HtmlDecode(cleanText);
                                        string preview = cleanText.Length > 80 ? cleanText.Substring(0, 80) + "..." : cleanText;

                                        string badgeStyle = "";
                                        string category = item.Category ?? "";
                                        if (category == "İş") { badgeStyle = "background:var(--primary-light);color:var(--primary);"; }
                                        else if (category == "Aile") { badgeStyle = "background:#dcfce7;color:#16a34a;"; }
                                        else if (category == "Eğitim") { badgeStyle = "background:#fef2f2;color:#dc2626;"; }
                                        else if (category == "Sosyal") { badgeStyle = "background:#fef9c3;color:#ca8a04;"; }

                                        string rowClass = isRead ? "read" : "unread";
                                        string senderStyle = isRead ? "color:var(--text-muted);" : "color:var(--text-primary);font-weight:600;";
                                        string subjectStyle = isRead ? "color:var(--text-muted);" : "color:var(--text-primary);font-weight:600;";
                                        string starClass = isStarred ? "bxs-star text-warning" : "bx-star text-muted";

                                        string detailUrl = "/Message/MessageDetail/" + item.MessageId;
                                        string starUrl = "/Message/ToggleStar/" + item.MessageId;
                                        string trashUrl = "/Message/MoveToTrash/" + item.MessageId;

                                        <div class="email-row @rowClass" data-id="@item.MessageId" onclick="window.location='@detailUrl'">
                                            <div class="flex-shrink-0 me-2" onclick="event.stopPropagation();">
                                                <input class="form-check-input email-checkbox" type="checkbox" style="width:15px;height:15px;" />
                                            </div>
                                            <div class="flex-shrink-0 me-2" onclick="event.stopPropagation();">
                                                <a href="@starUrl" style="text-decoration:none;">
                                                    <i class='bx @starClass mail-star'></i>
                                                </a>
                                            </div>
                                            <div class="mail-avatar me-3" style="background:@avatarColor;">@avatarLetter</div>
                                            <div class="mail-sender me-3" style="@senderStyle">@senderEmail</div>
                                            @if (!string.IsNullOrEmpty(category))
                                            {
                                                <span class="cat-badge me-2" style="@badgeStyle">@category</span>
                                            }
                                            <div class="mail-subject">
                                                <span style="@subjectStyle">@item.Subject</span>
                                                <span style="color:var(--text-muted);font-weight:400;"> — @preview</span>
                                            </div>
                                            <div class="flex-shrink-0 ms-3 d-flex align-items-center gap-2">
                                                <a href="@trashUrl" class="mail-delete" title="Çöpe At"
                                                   onclick="event.stopPropagation();if(!confirm('Mesajı çöpe taşımak istiyor musunuz?'))event.preventDefault();">
                                                    <i class="bx bx-trash"></i>
                                                </a>
                                                <span class="mail-date">@item.SendDate.ToString("dd MMM HH:mm")</span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- COMPOSE -->
                        <div class="compose-popup" id="composePopup">
                            <div class="compose-header" onclick="toggleCompose()">
                                <div class="compose-header-title"><i class='bx bx-edit-alt'></i><span>Yeni Mesaj</span></div>
                                <div class="compose-header-actions d-flex gap-1">
                                    <span onclick="event.stopPropagation();toggleCompose()" title="Küçült"><i class='bx bx-minus' style="font-size:18px;"></i></span>
                                    <span onclick="event.stopPropagation();closeCompose()" title="Kapat"><i class='bx bx-x' style="font-size:20px;"></i></span>
                                </div>
                            </div>
                            <div class="compose-body" id="composeBody">
                                <form method="post" action="/Message/CreateMessage" id="composeForm">
                                    @Html.AntiForgeryToken()
                                    <input class="compose-field" type="email" name="ReceiverEmail" placeholder="Kime (Email Adresi)" required />
                                    <input class="compose-field" type="text" name="Subject" placeholder="Konu" required />
                                    <select name="Category" class="compose-select">
                                        <option value="">Kategori Seçin (Opsiyonel)</option>
                                        <option value="İş">İş</option>
                                        <option value="Aile">Aile</option>
                                        <option value="Eğitim">Eğitim</option>
                                        <option value="Sosyal">Sosyal</option>
                                    </select>
                                    <div><textarea id="summernote" name="MessageDetail" required></textarea></div>
                                    <div class="compose-footer">
                                        <button type="submit" class="send-btn"><i class='bx bx-send me-1'></i> Gönder</button>
                                        <div class="ms-auto">
                                            <button type="button" class="compose-icon-btn danger" onclick="closeCompose()" title="İptal">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/vertical/assets/js/jquery.min.js"></script>
    <script src="~/vertical/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/vertical/assets/plugins/simplebar/js/simplebar.min.js"></script>
    <script src="~/vertical/assets/plugins/metismenu/js/metisMenu.min.js"></script>
    <script src="~/vertical/assets/plugins/perfect-scrollbar/js/perfect-scrollbar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <script>
        new PerfectScrollbar('.email-list');
        $(document).ready(function () {
            $('#summernote').summernote({
                placeholder: 'Mesajınızı buraya yazın...',
                tabsize: 2, height: 180,
                toolbar: [
                    ['style', ['style']], ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['color', ['color']], ['para', ['ul', 'ol', 'paragraph']], ['insert', ['link', 'picture']]
                ]
            });
        });
        function openCompose() { document.getElementById('composePopup').style.display = 'block'; document.getElementById('composeBody').style.display = 'block'; }
        function closeCompose() { document.getElementById('composePopup').style.display = 'none'; }
        function toggleCompose() { var b = document.getElementById('composeBody'); b.style.display = (b.style.display === 'none') ? 'block' : 'none'; }
        function toggleSelectAll(s) { document.querySelectorAll('.email-checkbox').forEach(function(c) { c.checked = s.checked; }); }
        function deleteSelected() {
            var ch = document.querySelectorAll('.email-checkbox:checked');
            if (ch.length === 0) { alert('Lütfen silmek istediğiniz mesajları seçin.'); return; }
            if (confirm(ch.length + ' mesajı çöpe taşımak istiyor musunuz?')) {
                var ids = []; ch.forEach(function(c) { var r = c.closest('[data-id]'); if (r) ids.push(r.getAttribute('data-id')); });
                var i = 0;
                function next() { if (i < ids.length) { fetch('/Message/MoveToTrash/' + ids[i++]).then(next); } else { location.reload(); } }
                next();
            }
        }
    </script>
    <script src="~/vertical/assets/js/app.js"></script>
</body>
</html>
